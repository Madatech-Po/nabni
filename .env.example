# Copy to .env.local and fill in. Never commit real values.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Playwright UI tests (npm run test:e2e) log in with these dedicated e2e
# accounts on the live project. A role whose pair is missing is skipped.
E2E_PARENT_EMAIL=
E2E_PARENT_PASSWORD=
E2E_EDUCATOR_EMAIL=
E2E_EDUCATOR_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
